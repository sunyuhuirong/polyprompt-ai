# PolyPrompt LLM 配置（OpenAI 兼容端点；三选一：env / ~/.polyprompt/config.json / CLI flags）
POLYPROMPT_BASE_URL=https://api.deepseek.com/v1
POLYPROMPT_API_KEY=sk-...
POLYPROMPT_MODEL=deepseek-chat
# 可选：请求超时毫秒
# POLYPROMPT_TIMEOUT=120000

# 其他兼容端点示例：
# 火山方舟:  https://ark.cn-beijing.volces.com/api/v3  + 模型 ep-xxxx / doubao-seed-1-6-250615
# OpenAI:   https://api.openai.com/v1                  + gpt-4o-mini
# 月之暗面:  https://api.moonshot.cn/v1                 + kimi-k2-0905-preview
# 阿里百炼:  https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-max
